# Copy to .env.local and fill in. .env.local is gitignored.

# Required — judge.py and iterate.py make LLM calls via OpenAI.
OPENAI_API_KEY=sk-...

# Optional — overrides the default model (gpt-4o-mini).
# Bigger models score more consistently but cost more per call.
# JUDGE_MCP_MODEL=gpt-4o

# Optional — hosted SSE deployment (Fly.io / Railway / Cloud Run).
# Leave unset for stdio mode (Claude Desktop / Cursor default).
# MCP_TRANSPORT=sse
# PORT=8003
# FASTMCP_HOST=0.0.0.0
